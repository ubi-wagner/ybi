# Railway injects DATABASE_URL automatically when you attach a Postgres service.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ybi
YBI_PERIOD=2025
# dev | prod. On a Railway deployment this MUST be prod: it sets the session
# cookie's Secure flag and closes CORS. The service refuses to boot on Railway
# while it says dev.
YBI_ENV=dev
# Evidence is written to YBI_STORAGE_DIR (default ./storage). On Railway that
# path must be a mounted volume; a container filesystem does not survive a
# deploy.
YBI_STORAGE_DIR=storage
# S3/R2 offload is configured for but NOT implemented — app/routers/evidence.py
# writes to the local path regardless. Setting these does nothing today.
# S3_BUCKET=
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Session signing. At least 32 bytes; the service refuses to authenticate
# with a shorter one (RFC 7518 3.2). Generate:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
YBI_JWT_SECRET=
# Bootstrap password for scripts/seed_actors.py. No default on purpose.
YBI_SEED_PASSWORD=
# The organisation's shared FIRST-LOGIN password, for a round where a set of
# accounts is opened at once and each person then claims their own. At least
# 12 characters; anything shorter is ignored outright rather than honoured.
#
# It is never stored against anybody's row — login accepts this value in
# addition, and only for accounts opened for the round (password_set_by =
# 'SEED'). It does NOT open an account whose password an administrator chose
# for one person, so a reset still restores exclusive control. So:
# clearing this variable withdraws it from everybody still on it, immediately
# and without a single password reset; rotating it is one change; and a copy
# of the database is not a copy of the credential.
#
# Leave it empty when no round is running. While it is set, anybody who has
# the value can claim any account that has not yet been claimed, so set it for
# the round and clear it when the round is done. Who is still on it is on the
# People screen, and every such sign-in is SIGN_IN_SHARED on the audit trail.
YBI_INITIAL_PASSWORD=
